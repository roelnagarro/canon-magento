<?php
/**
 * Rent a Toyota Brand Store - Homepage Template
 * @var \Magento\Framework\View\Element\Template $block
 */

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
/** @var \Magento\Cms\Model\Template\FilterProvider $filterProvider */
$filterProvider = $objectManager->get(\Magento\Cms\Model\Template\FilterProvider::class);

$cmsPageContent = '';
try {
    /** @var \Magento\Cms\Model\Page $cmsPage */
    $cmsPage = $objectManager->get(\Magento\Cms\Model\Page::class);
    $pageId = $block->getRequest()->getParam('page_id', $block->getRequest()->getParam('id'));
    if ($pageId) {
        $cmsPage->load($pageId);
    } else {
        $cmsPage->load('home', 'identifier');
    }
    if ($cmsPage->getId() && !empty(trim($cmsPage->getContent()))) {
        $cmsPageContent = $filterProvider->getPageFilter()->filter($cmsPage->getContent());
    }
} catch (\Exception $e) {
    $cmsPageContent = '';
}

$heroCmsBlockHtml = '';
try {
    $blockModel = $objectManager->create(\Magento\Cms\Block\Block::class)->setBlockId('home-hero-section');
    if ($blockModel) {
        $blockHtml = $blockModel->toHtml();
        if (!empty(trim($blockHtml))) {
            $heroCmsBlockHtml = $blockHtml;
        }
    }
} catch (\Exception $e) {
    $heroCmsBlockHtml = '';
}
?>
<div class="toyota-home-page">
    <div class="hero-section">
        <?php if (!empty(trim($heroCmsBlockHtml))): ?>
            <?= /* @noEscape */ $heroCmsBlockHtml ?>
        <?php else: ?>
            <?= /* @noEscape */ $cmsPageContent ?>
        <?php endif; ?>
    </div>

    <div class="dots-pattern-bg"></div>

    <div class="vehicle-banner-section">
        <img src="<?= $block->getViewFileUrl('images/footer-image.png') ?>" alt="Toyota Vehicles Banner"
            class="banner-image" />
    </div>
</div>