$scriptString = <<<JS
(function() {
    var form = document.getElementById('send-order-form');
    if (!form) return;
    form.addEventListener('submit', function(e) {
        var btn = document.getElementById('btn-send-order');
        if (btn) {
            btn.disabled = true;
            btn.style.opacity = '0.7';
            var span = btn.querySelector('span');
            if (span) span.innerText = 'Sending Order...';
        }
    });
})();
JS;
