<?php
/** @var $block \Magento\Checkout\Block\Onepage */
$om = \Magento\Framework\App\ObjectManager::getInstance();
$checkoutSession = $om->get(\Magento\Checkout\Model\Session::class);
$customerSession = $om->get(\Magento\Customer\Model\Session::class);
$quote = $checkoutSession->getQuote();

$items = [];
if ($quote && $quote->hasItems()) {
    $items = $quote->getAllVisibleItems();
}

$totalQty = 0;
foreach ($items as $item) {
    $totalQty += (int)$item->getQty();
}
if ($totalQty === 0 && !empty($items)) {
    $totalQty = count($items);
}

// Default Customer / Contact Information matching design mockup
$name = 'Scott Francis';
$dealership = 'Right Toyota';
$addressStr = '11212 Bell Road Scottsdale AZ';
$phone = '480-125-4568';
$email = 'sfrancis@righttoyota.com';

if ($customerSession->isLoggedIn()) {
    $customer = $customerSession->getCustomer();
    if ($customer->getName()) {
        $name = $customer->getName();
    }
    if ($customer->getEmail()) {
        $email = $customer->getEmail();
    }
    $defaultAddress = $customer->getDefaultBillingAddress();
    if ($defaultAddress) {
        if ($defaultAddress->getCompany()) {
            $dealership = $defaultAddress->getCompany();
        }
        $st = implode(' ', (array)$defaultAddress->getStreet());
        $ct = $defaultAddress->getCity();
        $rg = $defaultAddress->getRegion();
        if ($st || $ct || $rg) {
            $addressStr = trim("$st $ct $rg");
        }
        if ($defaultAddress->getTelephone()) {
            $phone = $defaultAddress->getTelephone();
        }
    }
}

// Sanitize strings to single-line whitespace
$name = trim(preg_replace('/\s+/', ' ', (string)$name));
$dealership = trim(preg_replace('/\s+/', ' ', (string)$dealership));
$addressStr = trim(preg_replace('/\s+/', ' ', (string)$addressStr));
$phone = trim(preg_replace('/\s+/', ' ', (string)$phone));
$email = trim(preg_replace('/\s+/', ' ', (string)$email));
