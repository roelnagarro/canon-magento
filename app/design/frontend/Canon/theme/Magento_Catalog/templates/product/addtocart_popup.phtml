<script>
require(['jquery', 'Magento_Customer/js/customer-data'], function($, customerData) {
    $(document).ready(function() {
        var lastCapturedData = null;

        function findImageSrc($context) {
            var src = '';

            // Try PLP product item image
            if ($context && $context.length) {
                var $img = $context.find('.product-item-image-wrapper img, .product-image-photo, img[src*="/catalog/product/"], img[src*="media/catalog"]').first();
                if ($img.length && $img.attr('src')) {
                    src = $img.attr('src');
                }
            }

            // Try PDP gallery image
            if (!src) {
                var $pdpImg = $('.gallery-placeholder img, .fotorama__stage__frame.fotorama__active img, .fotorama__img, .product.media img, img[src*="/catalog/product/"], img[src*="media/catalog"]').first();
                if ($pdpImg.length && $pdpImg.attr('src')) {
                    src = $pdpImg.attr('src');
                }
            }

            // Fallback: any product image on page
            if (!src) {
                var $anyImg = $('img[src*="/catalog/product/"], img[src*="media/catalog"]').first();
                if ($anyImg.length && $anyImg.attr('src')) {
                    src = $anyImg.attr('src');
                }
            }

            return src;
        }

        // Capture item details when Add to Cart form is submitted or button clicked
        $(document).on('submit', 'form[data-role="tocart-form"], #product_addtocart_form', function(e) {
            var $form = $(this);
            var $itemWrapper = $form.closest('.product-item, .product-info-main, .box-tocart, body');

            var name = '';
            var sku = $form.attr('data-product-sku') || '';
            var price = '';
            var imgSrc = findImageSrc($itemWrapper);
            var qty = 1;
            var optionText = '';

            // Extract PDP info
            if ($('.product-info-main').length) {
                var $pdp = $('.product-info-main');
                name = $.trim($pdp.find('.page-title span, h1.page-title').text());
                if (!sku) {
                    sku = $.trim($pdp.find('.sku .value, .product-info-stock-sku .value').text());
                }
                price = $.trim($pdp.find('.price-box .price').first().text());
                qty = parseInt($('#qty').val()) || 1;
                optionText = $.trim($('.custom-size-swatches .swatch-option.selected').text());
            } 
            
            // Extract PLP / Grid item info
            if (!name && $itemWrapper.length) {
                name = $.trim($itemWrapper.find('.product-item-name, .product-name').text());
                price = $.trim($itemWrapper.find('.price-box .price').first().text());
            }

            lastCapturedData = {
                name: name,
                sku: sku,
                price: price,
                imgSrc: imgSrc,
                qty: qty,
                optionText: optionText
            };
        });

        function renderAndShowModal(data) {
            if (!data) return;

            // Product Name
            if (data.name) $('#addtocart-modal-name').text(data.name);

            // Product SKU
            var skuText = data.sku || '';
            if (skuText && !skuText.toLowerCase().startsWith('product id:')) {
                skuText = 'Product ID: ' + skuText;
            }
            if (skuText) $('#addtocart-modal-sku').text(skuText);

            // QTY Badge
            $('#addtocart-modal-qty').text('QTY: ' + (data.qty || 1));

            // Option Badge (e.g. Size)
            if (data.optionText) {
                $('#addtocart-modal-option').text(data.optionText).show();
            } else {
                $('#addtocart-modal-option').hide();
            }

            // Price
            if (data.price) $('#addtocart-modal-price').text(data.price);

            // Image
            if (data.imgSrc) {
                $('#addtocart-modal-image').attr('src', data.imgSrc).attr('alt', data.name || 'Product Image');
            }

            // Show modal with animation
            var $overlay = $('#addtocart-modal-overlay');
            $overlay.css('display', 'flex');
            $overlay[0].offsetHeight; // Trigger reflow for transition
            $overlay.addClass('is-open');
            $('body').addClass('addtocart-modal-active');
        }

        function closeModal() {
            var $overlay = $('#addtocart-modal-overlay');
            $overlay.removeClass('is-open');
            setTimeout(function() {
                $overlay.css('display', 'none');
                $('body').removeClass('addtocart-modal-active');
            }, 250);
        }

        // Subscribe to customerData cart reloads for exact real-time server data sync
        customerData.get('cart').subscribe(function(cart) {
            if (cart && cart.items && cart.items.length > 0) {
                var latestItem = cart.items[0];
                if (latestItem) {
                    if (latestItem.product_name) $('#addtocart-modal-name').text(latestItem.product_name);
                    
                    if (latestItem.product_sku) {
                        var skuStr = latestItem.product_sku;
                        if (!skuStr.toLowerCase().startsWith('product id:')) {
                            skuStr = 'Product ID: ' + skuStr;
                        }
                        $('#addtocart-modal-sku').text(skuStr);
                    }

                    if (latestItem.product_image && latestItem.product_image.src) {
                        $('#addtocart-modal-image').attr('src', latestItem.product_image.src).attr('alt', latestItem.product_name || 'Product Image');
                    }

                    if (latestItem.qty) $('#addtocart-modal-qty').text('QTY: ' + latestItem.qty);

                    if (latestItem.product_price) {
                        var pText = typeof latestItem.product_price === 'string' && latestItem.product_price.indexOf('<') !== -1
                            ? $(latestItem.product_price).text()
                            : latestItem.product_price;
                        if (pText) $('#addtocart-modal-price').text($.trim(pText));
                    }

                    if (latestItem.options && latestItem.options.length > 0) {
                        var optVal = latestItem.options[0].value || latestItem.options[0].option_value;
                        if (optVal) {
                            $('#addtocart-modal-option').text(optVal).show();
                        }
                    }
                }
            }
        });

        // Listen for Magento catalogAddToCart AJAX trigger
        $(document).on('ajax:addToCart', function(e, eventData) {
            var res = eventData && eventData.response ? eventData.response : null;
            if (res && (res.backUrl || res.displayMessages)) {
                return;
            }

            customerData.reload(['cart'], true);

            var cart = customerData.get('cart')();
            var latestItem = (cart && cart.items && cart.items.length) ? cart.items[0] : null;

            var finalData = $.extend({}, lastCapturedData);

            if (latestItem) {
                if (!finalData.name) finalData.name = latestItem.product_name;
                if (!finalData.sku) finalData.sku = latestItem.product_sku;
                if (!finalData.price) finalData.price = $(latestItem.product_price).text() || latestItem.product_price;
                if (!finalData.imgSrc && latestItem.product_image) finalData.imgSrc = latestItem.product_image.src;
                if (latestItem.qty) finalData.qty = latestItem.qty;
                if (!finalData.optionText && latestItem.options && latestItem.options.length) {
                    finalData.optionText = latestItem.options[0].value || latestItem.options[0].option_value;
                }
            }

            renderAndShowModal(finalData);
        });

        // Backup hook into ajaxComplete for cart add
        $(document).ajaxComplete(function(event, xhr, settings) {
            if (settings.url && settings.url.indexOf('checkout/cart/add') !== -1) {
                try {
                    var res = xhr.responseJSON || JSON.parse(xhr.responseText);
                    if (res && (res.backUrl || res.displayMessages)) {
                        return;
                    }
                } catch(err) {}

                customerData.reload(['cart'], true);

                setTimeout(function() {
                    if (!$('#addtocart-modal-overlay').hasClass('is-open')) {
                        var cart = customerData.get('cart')();
                        var latestItem = (cart && cart.items && cart.items.length) ? cart.items[0] : null;
                        var finalData = $.extend({}, lastCapturedData);
                        if (latestItem) {
                            if (!finalData.name) finalData.name = latestItem.product_name;
                            if (!finalData.sku) finalData.sku = latestItem.product_sku;
                            if (!finalData.price) finalData.price = $(latestItem.product_price).text() || latestItem.product_price;
                            if (!finalData.imgSrc && latestItem.product_image) finalData.imgSrc = latestItem.product_image.src;
                            if (latestItem.qty) finalData.qty = latestItem.qty;
                            if (!finalData.optionText && latestItem.options && latestItem.options.length) {
                                finalData.optionText = latestItem.options[0].value || latestItem.options[0].option_value;
                            }
                        }
                        renderAndShowModal(finalData);
                    }
                }, 200);
            }
        });

        // Close actions
        $(document).on('click', '#addtocart-modal-close, #addtocart-modal-continue', function(e) {
            e.preventDefault();
            closeModal();
        });

        // Close on backdrop click
        $(document).on('click', '#addtocart-modal-overlay', function(e) {
            if ($(e.target).is('#addtocart-modal-overlay')) {
                closeModal();
            }
        });

        // Close on ESC key
        $(document).keyup(function(e) {
            if (e.key === "Escape" || e.keyCode === 27) {
                closeModal();
            }
        });
    });
});
</script>
