<?php
/** @var $block \Magento\Catalog\Block\Product\View */
?>
<?php $_product = $block->getProduct(); ?>
<?php $buttonTitle = __('Add to Order'); ?>
<?php if ($_product->isSaleable()) :?>
<div class="box-tocart">
    <div class="fieldset">


        <?php if ($block->shouldRenderQuantity()) :?>
        <div class="field qty">
            <label class="label" for="qty"><span><?= $block->escapeHtml(__('Quantity')) ?></span></label>
            <div class="control qty-stepper">
                <button type="button" class="qty-btn qty-minus" id="qty-minus" aria-label="Decrease quantity">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
                <input type="number"
                       name="qty"
                       id="qty"
                       min="1"
                       value="<?= $block->getProductDefaultQty() * 1 ?>"
                       title="<?= $block->escapeHtmlAttr(__('Qty')) ?>"
                       class="input-text qty"
                       data-validate="<?= $block->escapeHtml(json_encode($block->getQuantityValidators())) ?>"
                       />
                <button type="button" class="qty-btn qty-plus" id="qty-plus" aria-label="Increase quantity">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
            </div>
        </div>
        <?php endif; ?>

        <div class="actions">
            <button type="submit"
                    title="<?= $block->escapeHtmlAttr($buttonTitle) ?>"
                    class="action primary tocart"
                    id="product-addtocart-button">
                <span><?= $block->escapeHtml($buttonTitle) ?></span>
            </button>
            <?= $block->getChildHtml('', true) ?>
        </div>
    </div>
</div>
<script type="text/x-magento-init">
    {
        "#product_addtocart_form": {
            "Magento_Catalog/js/validate-product": {}
        }
    }
</script>
<script>
require(['jquery'], function($) {
    $(document).ready(function() {
        $(document).on('click', '#qty-minus', function(e) {
            e.preventDefault();
            var $qty = $('#qty');
            var val = parseInt($qty.val()) || 1;
            if (val > 1) {
                $qty.val(val - 1).trigger('change');
            }
        });
        $(document).on('click', '#qty-plus', function(e) {
            e.preventDefault();
            var $qty = $('#qty');
            var val = parseInt($qty.val()) || 1;
            $qty.val(val + 1).trigger('change');
        });

        function ensureOptionSelected() {
            var $radios = $('input[type="radio"][name^="options["]');
            if ($radios.length) {
                var checked = $radios.filter(':checked');
                if (!checked.length) {
                    var $first = $radios.first();
                    $first.prop('checked', true).trigger('change');
                    var valId = $first.val();
                    var optMatch = $first.attr('name').match(/options\[(\d+)\]/);
                    var optId = optMatch ? optMatch[1] : '';
                    if (optId && valId) {
                        $('[data-option-id="' + optId + '"][data-option-type-id="' + valId + '"]').addClass('selected');
                    }
                }
            }
        }

        // Auto-select first option on page ready if none checked
        ensureOptionSelected();

        $(document).on('click', '.swatch-option:not(.disabled), .custom-size-swatches .swatch-option:not(.disabled), [data-option-type-id]', function(e) {
            var $this = $(this);
            var optionId = $this.data('option-id') || $this.attr('data-option-id');
            var valueId = $this.data('option-type-id') || $this.attr('data-option-type-id');

            $this.closest('.swatch-attribute, .custom-size-swatches, .control, .fieldset').find('.swatch-option').removeClass('selected');
            $this.addClass('selected');

            if (optionId && valueId) {
                var $radio = $('#options_' + optionId + '_' + valueId);
                if (!$radio.length) {
                    $radio = $('input[name="options[' + optionId + ']"][value="' + valueId + '"]');
                }
                if ($radio.length) {
                    $radio.prop('checked', true).trigger('change');
                }
                var $select = $('select[name="options[' + optionId + ']"]');
                if ($select.length) {
                    $select.val(valueId).trigger('change');
                }
                var $superSelect = $('select[name="super_attribute[' + optionId + ']"]');
                if ($superSelect.length) {
                    $superSelect.val(valueId).trigger('change');
                }
            }
        });

        $(document).on('click', '#product-addtocart-button', function() {
            ensureOptionSelected();
        });
    });
});
</script>
<?php endif; ?>
