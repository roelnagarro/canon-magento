<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <move element="page.main.title" destination="product.info.main" before="-"/>
        <move element="product.info.stock.sku" destination="product.info.price" after="product.price.final"/>
        
        <!-- Hide review summary & detailed tabs -->
        <referenceBlock name="product.info.review" remove="true"/>
        <referenceBlock name="product.info.details" remove="true"/>

        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="product.info.back" template="Magento_Catalog::product/view/back.phtml" before="-"/>
            <block class="Magento\Framework\View\Element\Template" name="product.info.custom.description" template="Magento_Catalog::product/view/description.phtml" after="product.info.main"/>
        </referenceContainer>

        <referenceBlock name="product.info.sku" template="Magento_Catalog::product/view/sku.phtml"/>
        <referenceBlock name="product.info.addtocart" template="Magento_Catalog::product/view/addtocart.phtml"/>
    </body>
</page>
