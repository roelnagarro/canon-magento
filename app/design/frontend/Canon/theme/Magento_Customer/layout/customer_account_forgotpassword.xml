<?xml version="1.0"?>
<!--
/**
 * Customer Account Forgot Password Layout Override
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Forgot Password?</title>
    </head>
    <body>
        <attribute name="class" value="customer-account-forgotpassword-page"/>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceBlock name="forgotPassword" template="Magento_Customer::form/forgotpassword.phtml"/>
        <referenceContainer name="page.wrapper">
            <block class="Magento\Framework\View\Element\Template" name="toyota.dots.pattern" template="Magento_Customer::dots_pattern.phtml" after="page.content" before="toyota.footer"/>
        </referenceContainer>
    </body>
</page>
