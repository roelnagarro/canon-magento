<?xml version="1.0"?>
<!--
/**
 * Customer Account Dashboard Layout Override
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="customer_account_dashboard_info" template="Magento_Customer::account/dashboard/info.phtml"/>
        <referenceBlock name="customer_account_dashboard_address" template="Magento_Customer::account/dashboard/address.phtml"/>
        <move element="customer_account_dashboard_top" destination="content" after="customer_account_dashboard_address"/>
    </body>
</page>
