<?xml version="1.0"?>
<!--
/**
 * Custom Customer Account Layout Override
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceContainer name="sidebar.main">
            <block class="Magento\Framework\View\Element\Template" name="custom.customer.account.nav" template="Magento_Customer::account/navigation.phtml" before="-"/>
            <referenceBlock name="sidebar.main.account_nav" remove="true"/>
            <referenceBlock name="customer_account_navigation" remove="true"/>
        </referenceContainer>
        <referenceContainer name="sidebar.additional" remove="true"/>
    </body>
</page>
