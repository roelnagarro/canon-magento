<?php
/**
 * Customer Forgot Password Template - Custom Design
 *
 * @var \Magento\Customer\Block\Account\Forgotpassword $block
 * @var \Magento\Framework\View\Element\ButtonLockManager|null $buttonLockManager
 * @var \Magento\Framework\Escaper $escaper
 */
$buttonLockManager = $block->getData('button_lock_manager');
?>
<div class="customer-forgotpassword-container">
    <div class="customer-forgotpassword-header">
        <h1 class="customer-forgotpassword-title"><?= $escaper->escapeHtml(__('Forgot Password?')) ?></h1>
        <p class="customer-forgotpassword-subtitle"><?= $escaper->escapeHtml(__('Enter your email address below and we will send you a password reset link.')) ?></p>
    </div>

    <div class="customer-forgotpassword-card">
        <form class="form password forget form-forgotpassword"
              action="<?= $escaper->escapeUrl($block->getUrl('*/*/forgotpasswordpost')) ?>"
              method="post"
              id="form-validate"
              data-mage-init='{"validation":{}}'>
            <?= $block->getBlockHtml('formkey') ?>

            <div class="field email required">
                <label for="email_address" class="label">
                    <span><?= $escaper->escapeHtml(__('Email')) ?></span>
                </label>
                <div class="control">
                    <input type="email"
                           name="email"
                           alt="email"
                           id="email_address"
                           class="input-text"
                           value="<?= $escaper->escapeHtmlAttr($block->getEmailValue()) ?>"
                           placeholder="Sfrancis@righttoyota.com"
                           data-validate="{required:true, 'validate-email':true}">
                </div>
            </div>

            <?= $block->getChildHtml('form_additional_info') ?>

            <div class="forgotpassword-actions">
                <button type="submit"
                        class="action submit primary btn-forgotpassword-submit"
                        id="send2"
                        <?php if ($buttonLockManager?->isDisabled('customer_forgot_password_form_submit')): ?> disabled="disabled" <?php endif; ?>>
                    <span><?= $escaper->escapeHtml(__('Reset My Password')) ?></span>
                </button>
            </div>

            <div class="forgotpassword-footer-links">
                <a class="action back-to-login" href="<?= $escaper->escapeUrl($block->getLoginUrl()) ?>">
                    <span><?= $escaper->escapeHtml(__('Back to Login')) ?></span>
                </a>
            </div>
        </form>
    </div>
</div>
<script type="text/x-magento-init">
    {
        "*": {
            "Magento_Customer/js/block-submit-on-send": {
                "formId": "form-validate"
            }
        }
    }
</script>
