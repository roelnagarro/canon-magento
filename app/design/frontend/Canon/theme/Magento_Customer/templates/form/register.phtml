<script>
require(['jquery'], function ($) {
    $(document).ready(function () {
        // Toggle password visibility
        $('.btn-toggle-password').on('click', function () {
            var targetId = $(this).data('target');
            var $input = $('#' + targetId);
            var isPassword = $input.attr('type') === 'password';
            
            $input.attr('type', isPassword ? 'text' : 'password');
            $(this).find('.icon-eye-off').toggle(!isPassword);
            $(this).find('.icon-eye').toggle(isPassword);
        });

        // Real-time password requirement checklist and strength indicator
        var $pwd = $('#password');
        var $label = $('#password-strength-label');
        var $segments = $('.password-strength-segments');
        var $ruleLength = $('.rule-item.rule-length');
        var $ruleLower = $('.rule-item.rule-lowercase');
        var $ruleUpper = $('.rule-item.rule-uppercase');
        var $ruleNumSym = $('.rule-item.rule-number-symbol');

        function updateRuleItem($elem, isMet) {
            if (isMet) {
                $elem.addClass('rule-met').removeClass('rule-unmet');
                $elem.find('.rule-icon').text('✓');
            } else {
                $elem.addClass('rule-unmet').removeClass('rule-met');
                $elem.find('.rule-icon').text('✕');
            }
        }

        function evaluatePassword() {
            var val = $pwd.val() || '';
            if (val.length === 0) {
                $label.text('No Password');
                $segments.attr('data-strength', 'none');
                updateRuleItem($ruleLength, false);
                updateRuleItem($ruleLower, false);
                updateRuleItem($ruleUpper, false);
                updateRuleItem($ruleNumSym, false);
                return;
            }

            var hasLength = val.length >= 8;
            var hasLower = /[a-z]/.test(val);
            var hasUpper = /[A-Z]/.test(val);
            var hasNumOrSym = /[0-9!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?`~]/.test(val);

            updateRuleItem($ruleLength, hasLength);
            updateRuleItem($ruleLower, hasLower);
            updateRuleItem($ruleUpper, hasUpper);
            updateRuleItem($ruleNumSym, hasNumOrSym);

            var score = 0;
            if (hasLength) score++;
            if (hasLower) score++;
            if (hasUpper) score++;
            if (hasNumOrSym) score++;

            if (score <= 1) {
                $label.text('Weak');
                $segments.attr('data-strength', 'weak');
            } else if (score >= 2 && score <= 3) {
                $label.text('Medium');
                $segments.attr('data-strength', 'medium');
            } else {
                $label.text('Strong');
                $segments.attr('data-strength', 'strong');
            }
        }

        $pwd.on('input keyup change paste', evaluatePassword);
        evaluatePassword();

        // Ensure errorPlacement neatly places validation error below input-icon-wrapper
        var setupErrorPlacement = function () {
            var v = $('#form-validate').data('validator');
            if (v && !v._toyotaCustomPlacementAttached) {
                v._toyotaCustomPlacementAttached = true;
                var origPlacement = v.settings.errorPlacement;
                v.settings.errorPlacement = function (error, element) {
                    var $wrapper = element.closest('.input-icon-wrapper');
                    if ($wrapper.length) {
                        $wrapper.after(error);
                    } else if (origPlacement) {
                        origPlacement(error, element);
                    } else {
                        element.after(error);
                    }
                };
            }
        };
        setupErrorPlacement();
        setTimeout(setupErrorPlacement, 250);
        setTimeout(setupErrorPlacement, 1000);
    });
});
</script>
