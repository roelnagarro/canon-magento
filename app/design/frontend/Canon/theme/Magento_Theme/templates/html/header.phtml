<?php
/**
 * Rent a Toyota Brand Store - Header Template
 * @var \Magento\Framework\View\Element\Template $block
 */

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$categoryFactory = $objectManager->get(\Magento\Catalog\Model\ResourceModel\Category\CollectionFactory::class);
$categories = $categoryFactory->create()
    ->addAttributeToSelect(['name', 'url_key'])
    ->addAttributeToFilter('is_active', 1)
    ->addAttributeToFilter('entity_id', ['gt' => 2])
    ->setOrder('position', 'ASC');

$currentUrl = $block->getUrl('*/*/*', ['_current' => true]);
$actionName = $block->getRequest()->getFullActionName();

$customerSession = $objectManager->get(\Magento\Customer\Model\Session::class);
$httpContext = $objectManager->get(\Magento\Framework\App\Http\Context::class);
$isLoggedIn = (bool)$httpContext->getValue(\Magento\Customer\Model\Context::CONTEXT_AUTH)
    || $customerSession->isLoggedIn()
    || (bool)$customerSession->getCustomerId()
    || (bool)$customerSession->getLoggedAsCustomerAdminId();

if (!$isLoggedIn) {
    try {
        $currentCustomerHelper = $objectManager->get(\Magento\Customer\Helper\Session\CurrentCustomer::class);
        if ($currentCustomerHelper->getCustomerId()) {
            $isLoggedIn = true;
        }
    } catch (\Exception $e) {
        // Ignore exception
    }
}

$profileUrl = $isLoggedIn ? $block->getUrl('customer/account') : $block->getUrl('customer/account/login');

$customerName = '';
if ($isLoggedIn) {
    try {
        if ($customerSession->getCustomer() && $customerSession->getCustomer()->getName()) {
            $customerName = trim((string)$customerSession->getCustomer()->getName());
        }
        if (empty($customerName) && $customerSession->getCustomerId()) {
            $customerRepository = $objectManager->get(\Magento\Customer\Api\CustomerRepositoryInterface::class);
            $customerRecord = $customerRepository->getById((int)$customerSession->getCustomerId());
            $customerName = trim($customerRecord->getFirstname() . ' ' . $customerRecord->getLastname());
        }
    } catch (\Exception $e) {
        // Fallback
    }
}
if (empty($customerName)) {
    $customerName = 'Scot Francis';
}

$checkoutSession = $objectManager->get(\Magento\Checkout\Model\Session::class);
$quote = $checkoutSession->getQuote();
$cartQty = ($quote && $quote->getId()) ? (int)$quote->getItemsQty() : 0;
?>
<header class="toyota-header">
    <div class="toyota-header-top">
        <div class="toyota-brand-container">
            <div class="toyota-logo-wrapper">
                <a href="/"><img src="<?= $block->getViewFileUrl('images/logo.svg') ?>" alt="Toyota Logo"
                        class="toyota-logo-icon" width="44" height="44" /></a>
                <div class="toyota-title-group">
                    <span class="toyota-title-main">Rent a Toyota</span>
                    <span class="toyota-title-divider">|</span>
                    <span class="toyota-title-sub">Brand Store™</span>
                </div>
            </div>
            <div class="toyota-tagline">
                Your source for Rent a Toyota branded merchandise, dealer materials, and program essentials.
            </div>
        </div>

        <a href="<?= $block->escapeUrl($profileUrl) ?>"
           class="toyota-user-profile"
           title="<?= $block->escapeHtmlAttr(__('User Profile')) ?>"
           style="<?= $isLoggedIn ? 'display: flex;' : 'display: none;' ?>">
            <div class="user-avatar">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="#6b7280">
                    <path
                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" />
                </svg>
            </div>
            <div class="user-info">
                <div class="user-name">
                    <span class="user-name-text"><?= $block->escapeHtml($customerName) ?></span>
                    <svg class="dropdown-caret" viewBox="0 0 24 24" width="14" height="14" fill="#374151">
                        <path d="M7 10l5 5 5-5z" />
                    </svg>
                </div>
                <div class="user-store">Right Toyota</div>
            </div>
        </a>
    </div>
    <div class="toyota-search-bar-container">
        <form class="search-form" id="search_mini_form" action="<?= $block->getUrl('catalogsearch/result/') ?>" method="get">
            <div class="search-input-wrapper">
                <input type="text"
                    id="search"
                    name="q"
                    value="<?= $block->escapeHtmlAttr($block->getRequest()->getParam('q', '')) ?>"
                    placeholder="<?= $block->escapeHtmlAttr(__('What are you looking for?')) ?>"
                    class="search-input"
                    maxlength="128"
                    autocomplete="off" />
                <button type="submit" class="search-submit-btn" title="<?= $block->escapeHtmlAttr(__('Search')) ?>" aria-label="<?= $block->escapeHtmlAttr(__('Search')) ?>">
                    <svg class="search-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7.5"></circle>
                        <line x1="16.5" y1="16.5" x2="21.5" y2="21.5"></line>
                    </svg>
                    <span class="search-btn-text"><?= $block->escapeHtml(__('Search')) ?></span>
                </button>
            </div>
        </form>

        <div class="filter-pills-group">
            <a href="<?= $block->getUrl('catalogsearch/result/', ['_query' => ['q' => '']]) ?>"
                class="pill-btn <?= ($actionName === 'cms_index_index' || ($actionName === 'catalogsearch_result_index' && empty($block->getRequest()->getParam('q')))) ? 'pill-btn-active' : '' ?>">
                Show All
            </a>
            <?php foreach ($categories as $category): ?>
                <?php
                    $urlKey = (string)$category->getUrlKey();
                    $catId = (string)$category->getId();
                    $isCatActive = ($actionName === 'catalog_category_view') && (
                        (strpos($currentUrl, $urlKey) !== false)
                        || (strpos($currentUrl, 'id/' . $catId) !== false)
                        || ($block->getRequest()->getParam('id') == $catId)
                    );
                    $catUrl = $block->getUrl('catalog/category/view', ['s' => $urlKey, 'id' => $catId]);
                ?>
                <a href="<?= $escaper->escapeUrl($catUrl) ?>"
                    class="pill-btn <?= $isCatActive ? 'pill-btn-active' : '' ?>">
                    <?= $block->escapeHtml($category->getName()) ?>
                </a>
            <?php endforeach; ?>
        </div>

        <div class="cart-wrapper">
            <a href="<?= $block->getUrl('checkout/cart') ?>" class="cart-link">
                <svg class="cart-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#4b5563"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span class="cart-badge"><?= (int)$cartQty ?></span>
            </a>
        </div>
    </div>
</header>
<script>
require(['jquery', 'Magento_Customer/js/customer-data'], function($, customerData) {
    var serverIsLoggedIn = <?= $isLoggedIn ? 'true' : 'false' ?>;

    var updateBadge = function() {
        var cart = customerData.get('cart')();
        var count = 0;
        if (cart && typeof cart.summary_count !== 'undefined') {
            count = parseInt(cart.summary_count) || 0;
        }
        $('.cart-badge').text(count);
    };
    customerData.get('cart').subscribe(updateBadge);
    updateBadge();

    var updateProfile = function() {
        var customer = customerData.get('customer')();
        var hasCustomer = Boolean(customer && (customer.firstname || customer.fullname));

        if (hasCustomer) {
            $('.toyota-user-profile').css('display', 'flex');
            if (customer.fullname) {
                $('.toyota-user-profile .user-name-text').text(customer.fullname);
            }
        } else if (!serverIsLoggedIn) {
            $('.toyota-user-profile').hide();
        } else {
            $('.toyota-user-profile').css('display', 'flex');
        }
    };
    customerData.get('customer').subscribe(updateProfile);
    updateProfile();

    if (serverIsLoggedIn) {
        var currentCust = customerData.get('customer')();
        if (!currentCust || !currentCust.firstname) {
            customerData.reload(['customer'], true);
        }
    }

    // Reload cart section to clear stale browser local storage data
    customerData.reload(['cart'], true);
});
</script>