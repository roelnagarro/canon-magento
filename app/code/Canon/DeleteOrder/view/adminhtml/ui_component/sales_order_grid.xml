<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Ui/etc/ui_configuration.xsd">
    <container name="listing_top">
        <massaction name="listing_massaction">
            <action name="canon_delete_order">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected order(s)? This action cannot be undone.</message>
                        <title translate="true">Delete Order(s)</title>
                    </confirm>
                    <url path="canon_deleteorder/order/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete Order(s)</label>
                </settings>
            </action>
        </massaction>
    </container>
</listing>
